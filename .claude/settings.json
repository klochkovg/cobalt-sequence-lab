{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make format-check)",
      "Bash(make mypy)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make ci)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)"
    ],
    "deny": [
      "Bash(git:*)",
      "Bash(gh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_git.py\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
